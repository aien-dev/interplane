{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interplane.dev/schemas/0.1/common.schema.json",
  "title": "INTERPLANE common definitions",
  "$defs": {
    "ProtocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "MAJOR.MINOR. Receivers reject any MAJOR they do not implement."
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "description": "Opaque identifier. Uniqueness scope is stated per field."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp, UTC recommended."
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Lower-case hex SHA-256 with an algorithm prefix."
    },
    "Party": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "model",
            "runtime",
            "adapter",
            "operator",
            "other"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trust": {
          "oneOf": [
            {
              "$ref": "#/$defs/TrustLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_kind": {
          "oneOf": [
            {
              "$ref": "#/$defs/ContentKind"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "ToolRef": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "namespace": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Canonical namespace when the model used one (e.g. filesystem). null when the model emitted a bare runtime-native name."
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      },
      "additionalProperties": false
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "unsupported_version",
        "unsupported_dialect",
        "malformed_envelope",
        "malformed_tool_call",
        "invalid_arguments",
        "oversized_arguments",
        "duplicate_request_id",
        "replayed_message",
        "unknown_capability",
        "capability_not_found",
        "policy_denied",
        "approval_required",
        "execution_error",
        "execution_timeout",
        "unknown_decision",
        "runtime_unavailable",
        "stale_capability"
      ]
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean",
          "default": false
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "RuntimeExtension": {
      "type": "object",
      "description": "Typed runtime-specific metadata. The vocabulary names the runtime's own meaning; INTERPLANE never interprets the values.",
      "required": [
        "vocabulary",
        "values"
      ],
      "properties": {
        "vocabulary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "CapabilityDescriptor": {
      "type": "object",
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "description": "Runtime-native capability name."
        },
        "canonical": {
          "oneOf": [
            {
              "$ref": "#/$defs/ToolRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical INTERPLANE tool this capability realizes, if the runtime declares one."
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "parameters": {
          "type": "object",
          "description": "JSON Schema (2020-12 or draft-07 subset) for arguments.",
          "additionalProperties": true
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          },
          "description": "Coarse selection tags such as filesystem, code, email, calendar, web, image, admin."
        },
        "runtime_effects": {
          "oneOf": [
            {
              "$ref": "#/$defs/RuntimeExtension"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "ContentKind": {
      "type": "string",
      "enum": [
        "runtime_instruction",
        "user_request",
        "model_generated",
        "tool_result",
        "workspace_content",
        "memory",
        "web_content",
        "document",
        "email",
        "skill",
        "external_provider",
        "unknown"
      ],
      "description": "What a piece of model-visible material is. On an executed result an absent or null kind is tool_result. A value the receiver does not recognize (or a non-string) is treated as unknown."
    },
    "TrustLevel": {
      "type": "string",
      "enum": [
        "trusted_runtime",
        "user_supplied",
        "workspace_untrusted",
        "external_untrusted",
        "unknown"
      ],
      "description": "How much the runtime trusts the material. Only the runtime assigns it; a model cannot raise it. Inability to determine trust (absent or null) is `unknown`, never silently trusted. A value the receiver does not recognize (or a non-string) is treated as external_untrusted. `trusted` is derived from this level and is never true for unknown or unrecognized values."
    }
  }
}