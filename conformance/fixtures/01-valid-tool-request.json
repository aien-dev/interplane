{
  "case": "01-valid-tool-request",
  "description": "A well-formed OpenAI read_file call is mapped, authorized by the mock runtime and executed.",
  "limits": {
    "max_argument_bytes": 65536
  },
  "trace_id": "trace-01",
  "steps": [
    {
      "turn": 0,
      "dialect": "openai",
      "model": "mock-model",
      "input": {
        "role": "assistant",
        "content": "I will read the file.",
        "tool_calls": [
          {
            "id": "call_01a",
            "type": "function",
            "function": {
              "name": "read_file",
              "arguments": "{\"path\": \"/tmp/a.txt\"}"
            }
          }
        ]
      }
    }
  ],
  "expected": {
    "observed": [
      {
        "request_id": "call_01a",
        "stage": "SUCCEEDED",
        "decision": "authorized",
        "status": "ok",
        "error_code": null,
        "decide_invoked": true,
        "execute_invoked": true,
        "result_digest": null
      }
    ],
    "turns": [
      {
        "turn": 0,
        "outcome": "tool_request",
        "intents": 1,
        "rejected": 0,
        "text": "I will read the file."
      }
    ],
    "runtime": {
      "decide_calls": 1,
      "execute_calls": 1
    },
    "result_checks": [
      {
        "request_id": "call_01a",
        "path": "data",
        "equals": {
          "path": "/tmp/a.txt",
          "content": "mock content of /tmp/a.txt"
        }
      }
    ]
  }
}
