{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interplane.dev/schemas/0.1/event.schema.json",
  "title": "INTERPLANE Event (RelayLine v0.1 contract)",
  "description": "One step of a multi-round exchange. v0.1 defines the event vocabulary and ordering only; streaming transport is out of scope.",
  "type": "object",
  "required": ["kind", "event", "seq"],
  "properties": {
    "kind": {"const": "event"},
    "event": {"type": "string", "enum": ["turn_started", "tool_requested", "mapped", "decided", "execution_started", "result", "model_continuation", "final", "cancelled", "error"]},
    "seq": {"type": "integer", "minimum": 0, "description": "Monotonic per trace."},
    "request_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/Id"}, {"type": "null"}]},
    "turn": {"type": ["integer", "null"], "minimum": 0},
    "payload": {"type": "object", "additionalProperties": true},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
